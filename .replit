run = "node server.js"
entrypoint = "server.js"
hidden = [".git", "node_modules"]
modules = ["nodejs-24"]

[nix]
channel = "stable-23_11"

[deployment]
run = ["node", "server.js"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3456
externalPort = 3000

[[ports]]
localPort = 3457
externalPort = 3001

[[ports]]
localPort = 3999
externalPort = 3002
